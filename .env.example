# ─── Database ────────────────────────────────────────────────
# Any PostgreSQL provider works: Neon, Supabase, Railway, Render, local, etc.
# In production (Vercel), use your provider's POOLED connection string —
# serverless functions open a fresh connection pool per instance, and an
# unpooled URL exhausts small Postgres plans fast. See README for details.
DATABASE_URL="postgresql://user:password@localhost:5432/recruitiq?schema=public"
# Neon example (this project's provider): copy the "Pooled connection" string
# from your Neon project's dashboard, which already includes sslmode=require
# and channel_binding=require —
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require

# ─── Auth ────────────────────────────────────────────────────
# Required in production — the app refuses to start without it rather than
# falling back to an insecure default (it only does that in development).
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ─── AI (OpenRouter) ─────────────────────────────────────────
# Never hard-code a model name in application code — always read it from here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Leave unset in production — it's only a fallback for local dev and
# defaults to your Vercel deployment URL automatically when unset there.
OPENROUTER_SITE_URL="http://localhost:3001"
OPENROUTER_APP_NAME="RecruitIQ"

# ─── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed CORS origins. Leave unset in production —
# it defaults to your Vercel deployment URL automatically when unset there.
CLIENT_URL="http://localhost:3001"
# Public address of the live product. Every link that leaves the app uses it:
# emailed links (interview, set password, status, login, Company HR submission)
# and the /recq agency/job links recruiters share. Defaults to CLIENT_URL.
# Point it at the instance that holds the data (local dev → http://localhost:3001).
PUBLIC_APP_URL=http://localhost:3001

# ─── Resume storage ──────────────────────────────────────────
# "database" (default) stores resume bytes in Postgres — works everywhere,
# including Vercel serverless, with zero extra setup. "local" writes to
# disk and must only be used for local development (Vercel's filesystem
# isn't persistent). "cloud" is a stub for a future S3/R2/Cloudinary driver
# — see src/server/resume/storage/cloud.driver.js.
STORAGE_DRIVER=database
# Only used by the "local" driver.
UPLOAD_DIR="./uploads"
# Kept under 4.5MB: Vercel's Node.js serverless functions reject request
# bodies above that at the platform level, before Express ever sees them.
MAX_RESUME_SIZE_MB=4

# ─── Phase 2: email notifications ────────────────────────────
# EMAIL_PROVIDER: "smtp", "brevo" or "console". Unset → smtp when
# EMAIL_SMTP_HOST is set, else brevo when BREVO_API_KEY is set, else console
# (emails are printed in the server terminal instead of sent — nothing
# crashes, but nobody receives them).
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=
# 587 / 2525 use STARTTLS; 465 uses implicit TLS (or set EMAIL_SMTP_SECURE=true).
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# Sender for every provider — a bare address or "Name <address>".
EMAIL_FROM=
EMAIL_FROM_NAME="RecruitIQ"
# Brevo (only with EMAIL_PROVIDER=brevo).
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="RecruitIQ"

# ─── Feature flags (pending-features build plan) ─────────────
# Each defaults to today's behavior, so leaving them unset changes nothing.
# Accepts true/false (also 1/0, yes/no, on/off).
# P1: agencies are onboarded by the Portal Admin only — there is no sign-up
# page, and POST /auth/register/company returns 403. Create the first admin
# with scripts/create-admin.mjs. true re-enables agency self-registration.
ALLOW_COMPANY_SELF_REGISTER=false
# P4: public careers portal, guest apply with phone OTP, CV-only submission.
FEATURE_GUEST_APPLY=false
# P4: how OTP codes are sent. "console" (default) prints them in the API
# server's terminal — no SMS, no cost. "twilio" sends real SMS with the
# TWILIO_* values above (trial accounts: verified numbers only; Indian
# numbers need DLT registration for production).
SMS_DRIVER=console
# P4: prefix for phone numbers typed without a country code.
DEFAULT_PHONE_COUNTRY_CODE=+91
# P5: instant interview link (attend now or later) instead of slot booking.
# Each job still chooses its flow (Interviews → Interview flow); SLOT stays
# the default, so turning this on changes nothing until a job opts in.
FEATURE_INSTANT_INTERVIEW=false
# P8: client HR / hiring person portal.
FEATURE_CLIENT_PORTAL=false
# P9: /recq agency-link candidate flow (resume match -> email OTP -> interview
# access). The new canonical public candidate journey; /careers/* redirects to
# it. Defaults ON — set to false to hide every /recq route.
FEATURE_RECQ=true
# P9: the old cross-agency candidate job board (GET /jobs, applying to any job
# id). Off by default — candidates only reach jobs through an agency's link.
FEATURE_CANDIDATE_JOB_BOARD=false
# Testing only: a fixed 6-digit code that always passes OTP verification
# (email and phone), next to the real code. Leave empty in production.
OTP_TEST_CODE=
# "Start here" demo page (/start). On → it shows the demo accounts' emails and
# DEMO_PASSWORD (demo accounts only, created by `node scripts/seed-demo.mjs`).
DEMO_PAGE=false
DEMO_PASSWORD=Demo@123
