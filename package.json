{
  "name": "ai-recruitment-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered recruitment platform (Next.js + TypeScript)",
  "scripts": {
    "dev": "node init && next dev -p 3001",
    "build": "node init && prisma generate && next build",
    "start": "node init && next start -p 3001",
    "start:prod": "node init && next start -p 2020",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.mjs\"",
    "test:smoke": "tsx scripts/smoke-current-flow.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:demo-interviews": "tsx prisma/seed-demo-interviews.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.8.0",
    "next": "^16.0.0",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
